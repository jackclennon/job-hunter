{
  "name": "job-application-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p worker && tsc -p web",
    "test:db": "bash supabase/test/run.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "hono": "4.13.18",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  }
}
