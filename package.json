{
  "name": "job-application-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p worker && svelte-check --tsconfig web/tsconfig.json",
    "test:db": "bash supabase/test/run.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.9",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  }
}
