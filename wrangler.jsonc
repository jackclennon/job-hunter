{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-application-assistant",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  // The React app is built to web/dist and served as static assets.
  // Requests under /api go to the Worker first; any other path that is not a
  // file falls back to index.html so the single-page app can route it.
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    // 05:00 UTC daily enqueue, and the runner every 2 minutes.
    "crons": ["0 5 * * *", "*/2 * * * *"]
  },
  "observability": { "enabled": true }
  // Secrets, set with `wrangler secret put` (never committed):
  //   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SECRETS_KEY,
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
}
